# Copy this file to ".env" and fill in your real values. Never commit ".env" itself.

PORT=5000

# MongoDB connection string.
# Easiest option for a student project: create a free cluster at mongodb.com/cloud/atlas
# and paste the connection string it gives you here.
MONGO_URI=mongodb://127.0.0.1:27017/web-alert-system

# Any long random string. This signs your login tokens - keep it secret.
JWT_SECRET=change_this_to_a_long_random_string

# How long a login stays valid.
JWT_EXPIRES_IN=1d

# Email sending (Gmail example). You must use a Gmail "App Password", not your real password.
# Generate one at: myaccount.google.com/apppasswords (requires 2-Step Verification to be on)
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_character_app_password

# The frontend origin allowed to talk to this backend (for CORS).
# CORS only ever checks the origin (scheme+host+port), never a path - keep this WITHOUT
# a trailing path like /frontend.
CLIENT_ORIGIN=http://127.0.0.1:5500

# The actual base URL where your frontend pages are served, used to build links inside
# emails (password reset, etc). This is often the SAME as CLIENT_ORIGIN, but not always -
# e.g. with VS Code Live Server, your pages usually live under /frontend, so this needs the
# extra path segment while CLIENT_ORIGIN above must not have it.
FRONTEND_URL=http://127.0.0.1:5500/frontend

# Optional: paste a Discord webhook URL to mirror every alert into a Discord channel.
# Get one in Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# Leave blank to skip Discord entirely - nothing else breaks if this is empty.
DISCORD_WEBHOOK_URL=
